{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# Railway healthcheck only; returns upstream's tiny status JSON.
	handle /health {
		reverse_proxy 127.0.0.1:{$APP_PORT:8787}
	}
	handle {
		basic_auth {
			{$NIUBIGEO_USERNAME:admin} {$NIUBIGEO_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:{$APP_PORT:8787} {
			flush_interval -1
		}
	}
}
