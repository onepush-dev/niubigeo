{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# Railway healthcheck only; returns upstream's tiny {"ok":true}.
	handle /health {
		reverse_proxy 127.0.0.1:{$APP_PORT:8787}
	}
	# Login page / cookie issuer (railway/gate.mjs).
	handle /_gate/* {
		reverse_proxy 127.0.0.1:{$GATE_PORT:8789}
	}
	handle {
		forward_auth 127.0.0.1:{$GATE_PORT:8789} {
			uri /_gate/verify
		}
		reverse_proxy 127.0.0.1:{$APP_PORT:8787} {
			flush_interval -1
		}
	}
}
